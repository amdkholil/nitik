{
    "name": "kholil/nitik",
    "description": "A Laravel package to track and aggregate application errors via custom log driver, with Filament dashboard.",
    "keywords": [
        "kholil",
        "laravel",
        "nitik",
        "error-tracking",
        "log-driver",
        "filament"
    ],
    "homepage": "https://github.com/amdkholil/nitik",
    "license": "MIT",
    "authors": [
        {
            "name": "Kholil",
            "email": "amdkholil@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "spatie/laravel-package-tools": "^1.16",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "filament/filament": "^4.0|^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Kholil\\Nitik\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kholil\\Nitik\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kholil\\Nitik\\NitikServiceProvider"
            ],
            "aliases": {
                "Nitik": "Kholil\\Nitik\\Facades\\Nitik"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
